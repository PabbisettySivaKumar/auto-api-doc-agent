# Copy to `.env` and fill in. All values are optional for dry-run.

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub — single-repo local mode (personal access token)
GITHUB_TOKEN=
GITHUB_REPO=owner/name
BASE_BRANCH=main

# GitHub App — Phase 2 webhook service (all repos)
GITHUB_APP_ID=
# Provide the private key inline OR as a file path (one of the two):
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./app-private-key.pem
# Must match the webhook secret you set when creating the App:
GITHUB_WEBHOOK_SECRET=

# Behavior
CONFIDENCE_THRESHOLD=0.6
OUTPUT_DIR=out

# RAG (Phase 3: large / scattered / external docs)
GEMINI_EMBED_MODEL=gemini-embedding-001
# Directory of docs outside the repo (exported Confluence/Notion, etc.).
# If set, RAG retrieval is used.
EXTERNAL_DOCS_DIR=
RAG_MIN_DOCS=25
RAG_TOP_K=4
RAG_FORCE=

# Layered feature docs (Phase D). "single" = push -> one API.md sync PR.
# "layered" = also handle PRs, committing two-tier feature docs onto the
# PR branch. Requires subscribing the App to Pull request events.
DOC_MODE=single
# Strip this dir prefix before resolving a feature (e.g. "src").
SOURCE_ROOT=
